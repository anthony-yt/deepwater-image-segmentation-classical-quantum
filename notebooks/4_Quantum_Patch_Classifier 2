      "source": [
        "dev=qml.device(\"default.qubit\",wires=6,shots=None)\n",
        "@qml.qnode(dev,interface=\"torch\",diff_method=\"backprop\")\n",
        "def circuit(x,w):\n",
        "    qml.AmplitudeEmbedding(x,wires=range(6),normalize=False)\n",
        "    qml.StronglyEntanglingLayers(w,wires=range(6))\n",
        "    return qml.expval(qml.PauliZ(0))\n",
        "def probability(x,w): return ((1+circuit(x,w))/2).clamp(1e-7,1-1e-7)\n",
        "def predict_vqc(x,w):\n",
        "    with torch.no_grad():\n",
        "        return np.concatenate([probability(torch.tensor(x[i:i+BATCH]),w).numpy().reshape(-1) for i in range(0,len(x),BATCH)])\n",
        "def metrics(yy,pp):\n",
        "    return dict(accuracy=accuracy_score(yy,pp),balanced_accuracy=balanced_accuracy_score(yy,pp),\n",
        "        precision=precision_score(yy,pp,zero_division=0),recall=recall_score(yy,pp,zero_division=0),\n",
        "        f1=f1_score(yy,pp,zero_division=0),iou=jaccard_score(yy,pp,zero_division=0))\n",
        "def train_vqc(x,seed):\n",
        "    torch.manual_seed(seed)\n",
        "    w=torch.nn.Parameter(.1*torch.randn(2,6,3))\n",
        "    opt=torch.optim.Adam([w],lr=LR)\n",
        "    xx=torch.tensor(x[idx[\"train\"]]); yy=torch.tensor(y[idx[\"train\"]],dtype=torch.float64)\n",
        "    cw=torch.tensor(len(yy)/(2*np.bincount(y[idx[\"train\"]],minlength=2)))\n",
        "    best=-1; hist=[]\n",
        "    for epoch in range(1,EPOCHS+1):\n",
        "        total=0.\n",
        "        for batch in torch.randperm(len(xx)).split(BATCH):\n",
        "            opt.zero_grad(); p=probability(xx[batch],w)\n",
        "            loss=(-(yy[batch]*torch.log(p)+(1-yy[batch])*torch.log(1-p))*cw[yy[batch].long()]).mean()\n",
        "            loss.backward()\n",
        "            assert w.grad is not None and torch.isfinite(w.grad).all()\n",
        "            opt.step(); total+=loss.item()*len(batch)\n",
        "        vf=f1_score(y[idx[\"val\"]],predict_vqc(x[idx[\"val\"]],w)>=.5,zero_division=0)\n",
        "        hist.append(dict(epoch=epoch,loss=total/len(xx),val_f1=vf))\n",
        "        if vf>best: best=vf; best_w=w.detach().clone()\n",
        "        if epoch==1 or epoch%5==0: print(f\"seed={seed} epoch={epoch}/{EPOCHS} loss={total/len(xx):.4f} val_F1={vf:.3f}\",flush=True)\n",
        "    return best_w,hist\n",
        "test_w=torch.nn.Parameter(torch.randn(2,6,3)*.1)\n",
        "probability(torch.tensor(X[\"Crudos\"][:2]),test_w).sum().backward()\n",
        "assert test_w.grad is not None and torch.isfinite(test_w.grad).all()\n",
        "print(\"Gradiente/batching OK\")\n"
      ]
