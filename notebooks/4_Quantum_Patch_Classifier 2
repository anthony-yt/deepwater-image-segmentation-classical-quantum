        "def key(p): return re.sub(r\"_mask$\",\"\",Path(p).stem,flags=re.I)\n",
        "paths={m:{key(p):p for p in (DATA/m).iterdir() if p.is_file()} for m in METHODS}\n",
        "mask_paths={key(p):p for p in (DATA/\"Masks\").iterdir() if p.is_file()}\n",
        "names=sorted(paths[\"Crudos\"])\n",
        "assert names\n",
        "_missing_hint=(\" Revisa OUT/'download_failures.csv' de la celda de descarga: \"\n",
        "    \"probablemente faltan archivos por un fallo de Drive no resuelto.\") \\\n",
        "    if (OUT/\"download_failures.csv\").exists() else \"\"\n",
        "for m in METHODS:\n",
        "    assert set(paths[m])==set(names),f\"Frames distintos en {m}; no se acepta comparación parcial.{_missing_hint}\"\n",
        "assert set(mask_paths)<=set(names),\"Máscaras sin imagen.\"\n",
        "def read_image(p):\n",
        "    a=cv2.imread(str(p),cv2.IMREAD_GRAYSCALE)\n",
        "    if a is None: raise ValueError(str(p))\n",
        "    return cv2.resize(a,(SIZE,SIZE),interpolation=cv2.INTER_AREA).astype(float)/255\n",
        "def read_mask(p):\n",
        "    a=cv2.imread(str(p),cv2.IMREAD_UNCHANGED)\n",
        "    if a is None: raise ValueError(str(p))\n",
        "    if a.ndim==3:\n",
        "        if not (np.array_equal(a[...,0],a[...,1]) and np.array_equal(a[...,0],a[...,2])):\n",
        "            raise ValueError(f\"Máscara multicolor: {p}. Revisar.\")\n",
        "        a=a[...,0]\n",
        "    if not set(np.unique(a)).issubset({0,1,255}): raise ValueError(f\"Máscara no binaria: {p}\")\n",
        "    a=(a>0).astype(np.uint8)\n",
        "    if INVERT_MASKS: a=1-a\n",
        "    return cv2.resize(a,(SIZE,SIZE),interpolation=cv2.INTER_NEAREST)\n",
        "images={m:{n:read_image(paths[m][n]) for n in names} for m in METHODS}\n",
        "masks={n:read_mask(p) for n,p in mask_paths.items()}\n",
        "audit=pd.DataFrame([dict(frame=n,has_mask=n in masks,mask_occupancy=float(masks[n].mean()) if n in masks else np.nan) for n in names])\n",
        "audit.to_csv(OUT/\"dataset_audit.csv\",index=False)\n",
        "display(audit)\n",
        "fig,axes=plt.subplots(2,4,figsize=(12,6))\n",
        "for ax,n in zip(axes.flat,sorted(masks)[:8]):\n",
        "    ax.imshow(images[\"CLAHE\"][n],cmap=\"gray\")\n",
        "    ax.imshow(np.ma.masked_where(masks[n]==0,masks[n]),cmap=\"autumn\",alpha=.45,vmin=0,vmax=1)\n",
        "    ax.set_title(n,fontsize=7)\n",
        "for ax in axes.flat: ax.axis(\"off\")\n",
        "plt.suptitle(\"Revisar: región coloreada = estructura SAM\")\n",
        "plt.tight_layout(); plt.savefig(OUT/\"mask_audit.png\",dpi=160); plt.show()\n",
        "print(\"Imágenes:\",len(names),\"| con máscara:\",len(masks),\"| solo inferencia:\",len(names)-len(masks))\n"
