        "def amplitudes(a):\n",
        "    a=np.asarray(a,dtype=float).reshape(-1,64).copy()\n",
        "    norm=np.linalg.norm(a,axis=1,keepdims=True)\n",
        "    zero=norm[:,0]<1e-12\n",
        "    a[zero]=1/8; norm[zero]=1\n",
        "    return a/norm\n",
