      "source": [
        "FEATURE_NAMES=[\"L_media\",\"a_media\",\"b_media\",\"L_std\",\"a_std\",\"b_std\",\"log_gradiente\",\"log_textura\"]\n",
        "assert len(FEATURE_NAMES)==N_QUBITS\n",
        "def patch_features(rgb):\n",
        "    # 8 descriptores por parche: color CIE-Lab (media y dispersión), borde y textura\n",
        "    lab=cv2.cvtColor(rgb.astype(np.float32),cv2.COLOR_RGB2LAB); L=lab[...,0]\n",
        "    g=np.hypot(cv2.Sobel(L,cv2.CV_32F,1,0,ksize=3),cv2.Sobel(L,cv2.CV_32F,0,1,ksize=3))\n",
        "    lap=cv2.Laplacian(L,cv2.CV_32F)\n",
        "    out=[]\n",
        "    for r,c in coords:\n",
        "        s=np.s_[r:r+PATCH,c:c+PATCH]; P=lab[s]\n",
        "        out.append([*P.reshape(-1,3).mean(0),*P.reshape(-1,3).std(0),np.log1p(g[s].mean()),np.log1p(lap[s].var())])\n",
        "    return np.array(out)\n",
        "def patch_amplitudes(rgb):\n",
        "    # entrada de v1: parche en gris reducido a 8×8 -> 64 amplitudes normalizadas (6 qubits)\n",
        "    gray=cv2.cvtColor(rgb.astype(np.float32),cv2.COLOR_RGB2GRAY)\n",
        "    a=np.array([cv2.resize(gray[r:r+PATCH,c:c+PATCH],(8,8),interpolation=cv2.INTER_AREA).ravel() for r,c in coords],dtype=float)\n",
        "    nrm=np.linalg.norm(a,axis=1,keepdims=True); z=nrm[:,0]<1e-12; a[z]=1/8; nrm[z]=1\n",
        "    return a/nrm\n",
        "FEAT={m:{n:patch_features(images[m][n]) for n in names} for m in METHODS}\n",
        "AMP={m:{n:patch_amplitudes(images[m][n]) for n in names} for m in METHODS}\n",
        "pos_in_frame=meta.groupby(\"frame\").cumcount().to_numpy()\n",
        "def stack(D,m): return np.stack([D[m][f][k] for f,k in zip(meta.frame,pos_in_frame)])\n",
        "class AngleScaler:\n",
        "    # estandariza con estadísticas de TRAIN y mapea a ángulos en [-π/2, π/2]\n",
        "    def fit(self,x): self.mu=x.mean(0); self.sd=x.std(0)+1e-8; return self\n",
        "    def __call__(self,x): return np.clip((x-self.mu)/self.sd,-3,3)*np.pi/6\n",
        "X_raw={m:stack(FEAT,m) for m in METHODS}\n",
        "scalers={m:AngleScaler().fit(X_raw[m][idx[\"train\"]]) for m in METHODS}\n",
        "X_ang={m:scalers[m](X_raw[m]) for m in METHODS}\n",
        "X_amp={m:stack(AMP,m) for m in METHODS}\n",
        "for m in METHODS: assert np.allclose(np.linalg.norm(X_amp[m],axis=1),1)\n",
        "# Diagnóstico: cuánto separa cada característica tubo vs fondo en train (|d| de Cohen)\n",
        "tr=idx[\"train\"]\n",
        "sep=pd.DataFrame({m:[abs(X_ang[m][tr][y[tr]==1,j].mean()-X_ang[m][tr][y[tr]==0,j].mean())/(X_ang[m][tr][:,j].std()+1e-9)\n",
        "                     for j in range(N_QUBITS)] for m in METHODS},index=FEATURE_NAMES)\n",
        "display(sep.round(2).style.background_gradient(cmap=\"Greens\").set_caption(\"|d| de Cohen tubo vs fondo (train)\"))"
      ],
