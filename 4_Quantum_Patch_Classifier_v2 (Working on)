        "lovo=[]\n",
        "if len(vids)>=2:\n",
        "    m=chosen_method\n",
        "    for held in vids:\n",
        "        tr=np.flatnonzero((meta.video!=held)&(meta.split==\"train\")&(meta.y>=0))\n",
        "        va=np.flatnonzero((meta.video!=held)&(meta.split==\"val\")&(meta.y>=0))\n",
        "        te=np.flatnonzero((meta.video==held)&(meta.y>=0))\n",
        "        if len(set(y[te]))<2 or len(set(y[va]))<2:\n",
        "            print(f\"{held}: omitido (falta una clase)\"); continue\n",
        "        sc=AngleScaler().fit(X_raw[m][tr]); xa=sc(X_raw[m])\n",
        "        P,thr,_=train_vqc(\"ang\",xa,y,tr,va,chosen_seed,log=False)\n",
        "        pv=(predict_proba(\"ang\",xa[te],P)>=thr).astype(int)\n",
        "        lovo.append(dict(held_out=held,model=MAIN,**metrics(y[te],pv)))\n",
        "        svm=train_svm(xa,y,tr,va)\n",
        "        lovo.append(dict(held_out=held,model=\"SVM-ángulos\",**metrics(y[te],svm.predict(xa[te]))))\n",
        "        print(f\"{held}: VQC F1={lovo[-2]['f1']:.3f} | SVM F1={lovo[-1]['f1']:.3f}\",flush=True)\n",
        "    lovo=pd.DataFrame(lovo); lovo.to_csv(OUT/\"leave_one_video_out.csv\",index=False)\n",
        "    display(lovo.round(3))"
